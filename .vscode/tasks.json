{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jogar no terminal com tabuleiro físico",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/jogar-terminal.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
